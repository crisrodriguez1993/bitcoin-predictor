# Bitcoin Predictor System - Environment Configuration
# Master's Thesis - Universidad San Francisco de Quito (USFQ)
# Author: Cristian Rodríguez - 2025

# =============================================================================
# DATA SOURCES CONFIGURATION
# =============================================================================

# Binance Configuration
BINANCE_ENABLED=true
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVALS=1h,4h,1d
BINANCE_LIMIT=1000

# Yahoo Finance Configuration  
YAHOO_ENABLED=true
YAHOO_SYMBOL=BTC-USD
YAHOO_INTERVALS=1h,1d
YAHOO_PERIOD_1H=60d
YAHOO_PERIOD_1D=2y

# CoinGecko Configuration
COINGECKO_ENABLED=false
COINGECKO_COIN_ID=bitcoin
COINGECKO_VS_CURRENCY=usd
COINGECKO_DAYS_1H=30
COINGECKO_DAYS_1D=365
COINGECKO_API_KEY=

# CoinAPI Configuration (Optional)
COINAPI_ENABLED=false
COINAPI_SYMBOL=BTC
COINAPI_CURRENCY=USD
COINAPI_API_KEY=

# =============================================================================
# DATA STORAGE CONFIGURATION
# =============================================================================

# Data Paths
DATA_BRONZE_PATH=data/bronze
DATA_SILVER_PATH=data/silver
DATA_GOLD_PATH=data/gold

# File Management
CLEAN_OLD_FILES=true
BACKUP_OLD_FILES=false
MAX_BACKUP_DAYS=7

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=[%(asctime)s] %(levelname)s - %(message)s

# =============================================================================
# API RATE LIMITING
# =============================================================================

# Request delays (seconds)
BINANCE_DELAY=1
YAHOO_DELAY=0.5
COINGECKO_DELAY=2
COINAPI_DELAY=1

# Request timeouts (seconds)
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# =============================================================================
# FEATURES CONFIGURATION  
# =============================================================================

# Data Quality
VALIDATE_DATA=true
REMOVE_DUPLICATES=true
FILL_MISSING_VALUES=true

# Development/Production Mode
ENVIRONMENT=development
DEBUG_MODE=true

# =============================================================================
# DEPLOYMENT SECRETS (Override in production)
# =============================================================================

# Database (for future use)
# DATABASE_URL=
# DATABASE_PASSWORD=

# News Data Collection
NEWS_ENABLED=true
NEWS_SOURCES=coindesk,cointelegraph,bitcoin_magazine,decrypt
MAX_ARTICLES_PER_SOURCE=100
NEWS_DAYS_BACK=30

# NewsAPI Configuration (Optional - requires API key)
NEWSAPI_ENABLED=false
NEWSAPI_KEY=

# Reddit Configuration (No API key required)
REDDIT_ENABLED=true
REDDIT_SUBREDDITS=Bitcoin,CryptoCurrency,btc
REDDIT_LIMIT=50

# External APIs (for future use)
# SENTIMENT_API_KEY=

# Cloud Storage (for future use)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=